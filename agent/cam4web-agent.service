[Unit]
Description=cam4web camera uploader
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cam4web
SupplementaryGroups=video render
StateDirectory=cam4web
StateDirectoryMode=0700
Environment=CAM4WEB_QUEUE_DIR=/var/lib/cam4web
EnvironmentFile=/etc/cam4web-agent.env
ExecStart=/usr/bin/python3 /opt/cam4web/agent/cam4web_agent.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
